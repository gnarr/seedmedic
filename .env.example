# Optional. docker-compose.yml has a default for every variable below, so
# `docker compose up -d` works without this file. Copy it to `.env` beside the
# compose file when you want to change something:
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# The two you are most likely to edit
# ---------------------------------------------------------------------------

# Your media library on the host. Mounted read-only at /srv/media inside the
# container, so "/srv/media" is what you enter as the library root at
# /settings. Several libraries? Add more mount lines in docker-compose.yml and
# enter each container path as its own root.
MEDIA_PATH=/srv/media

# Where SeedMedic rebuilds a torrent's layout before handing it to qBittorrent.
# Mounted at the SAME path inside the container, which is deliberate: SeedMedic
# gives this path to the download client verbatim as the torrent's save path,
# and there is no translation between the two. Mount this exact path in your
# qBittorrent container as well, and enter it at /settings.
#
# Two rules, both of which cost you quietly rather than loudly:
#
#   1. Put it on the same filesystem as MEDIA_PATH — a sibling directory is the
#      easy way. Across two filesystems, reflinks and hard links are
#      unavailable and every repair costs a full copy of the media.
#   2. Do not put it inside MEDIA_PATH. SeedMedic refuses to start if the two
#      overlap, because that would mean writing inside your library.
#
# So if MEDIA_PATH=/mnt/tank/media, use /mnt/tank/seedmedic-staging.
STAGING_PATH=/srv/seedmedic/staging

# ---------------------------------------------------------------------------
# The rest usually needs no change
# ---------------------------------------------------------------------------

# Who owns everything SeedMedic writes — `id -u` and `id -g` on the host.
#
# On the first start, and after you change these, SeedMedic takes ownership of
# the host directories mounted at /data and at STAGING_PATH. It never touches
# the media mount.
#
# Use the same uid your qBittorrent runs as: staged files are handed to it
# directly, and it has to be able to read them.
PUID=1000
PGID=1000

# Extra groups, comma-separated, if your media is readable only through a group
# that is neither PGID nor world-readable. e.g. SUPPLEMENTARY_GIDS=44,993
#SUPPLEMENTARY_GIDS=

# config.toml and the SQLite database, together. The one directory worth
# backing up. Relative paths are relative to docker-compose.yml.
DATA_PATH=./data

# Host port for the web UI. The container always listens on 9899 internally.
SEEDMEDIC_PORT=9899

# Only needed if you change server.bind_address's port inside config.toml —
# the health check would otherwise keep probing 9899 and report the container
# unhealthy.
#SEEDMEDIC_HEALTH_PORT=9899
